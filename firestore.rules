rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{coupleCode} {
      allow read, write: if coupleCode.size() >= 3 && coupleCode.size() <= 12;

      match /{allSubcollections=**} {
        allow read, write: if coupleCode.size() >= 3 && coupleCode.size() <= 12;
      }
    }
  }
}
